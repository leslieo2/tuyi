{
  "manifest_version": 3,
  "name": "本地图片识别翻译",
  "version": "1.0.3",
  "minimum_chrome_version": "123",
  "description": "右键翻译网页图片中的文字，在侧栏阅读原文和译文。",
  "key": "",
  "permissions": [
    "contextMenus",
    "sidePanel",
    "nativeMessaging",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["image-selection.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开本地图片识别翻译"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
